/*!
 * @file src/game/board/king
 */
#ifndef _KING_
#define _KING_



// Necessary libraries
#include "definitions"
#include "game/board/square"



/*!
 * Class for defining how a king behaves.
 *
 * @see Piece
 */
class King : public Piece
{
    public:
                                    King(PieceType);
        inline      bool            isChecked() { return checked; }
        inline      void            setChecked(bool c) { checked = c; }
        inline      bool            isStaled() { return staled; }
        inline      void            setStaled(bool s) { staled = s; }
        inline      bool            isMated() { return mated; }
        inline      void            setMated(bool m) { mated = m; }
        inline      bool            hasCastled() { return castled; }
        inline      void            setCastled(bool c) { castled = c; }
        virtual     void            recalculateMoves(Board *);
        virtual     void            recalculateAttacks(Board *);
        virtual     vector<Move>    getAllMoves();

    private:
        bool        checked;
        bool        staled;
        bool        mated;
        bool        castled;
};



#endif // _KING_
