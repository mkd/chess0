/*!
 * @file src/game/board/square
 */
#ifndef _SQUARE_
#define _SQUARE_



// Necessary libraries
#include <iostream>
#include "definitions"
#include "game/board/piece"


using namespace std;



/*!
 * class Square
 * Square specification.
 *
 * This class contains certain data relative to a square, such as the current
 * piece on it (or empty), the color and the position of the square (both in
 * algebraic and internal representations).
 *
 * @see Board
 */
class Square
{
    public:
                            Square();
        inline  ColorType   getColor() { return color; }
        inline  void        setColor(ColorType c) { color = c; }
        inline  int         getPosition() { return position; }
        inline  void        setPosition(int p) { position = p; }
        inline  Piece      *getPiece() { return piece; }
        inline  void        setPiece(Piece *p) { piece = p; }
                string      toString();

    private:
        ColorType   color;      // color of the square
        int         position;   // internal integer representation of the square
        Piece      *piece;      // association with the piece on the square
};



#endif // _SQUARE_
