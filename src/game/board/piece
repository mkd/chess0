/*!
 * @file src/game/board/piece
 */
#ifndef _PIECE_
#define _PIECE_



// Necessary libraries
#include "definitions"
#include "utils"
#include "game/move"
class Square;
class Board;



/*!
 * Abstract class for defining how a piece should be made and behave.
 *
 * Every piece has to be associated with a square. That is, a piece does not
 * exist if it is not set on the board, thus not having a corresponding square.
 *
 * @see Square
 */
class Piece
{
    public:
        inline  ColorType        getColor() { return color; }
        inline  void             setColor(ColorType ct) { color = ct; }
        inline  PieceType        getType() { return type; }
        inline  void             setType(PieceType pt) { type = pt; }
        inline  BitBoard         getBB() { return bb; }
        inline  int              getPosition() { return position; }
        inline  void             setPosition(int p)
                                 {
                                     position = p;
                                     bb = BitboardFromPosition(p);
                                 }
        inline  char             getColumn() { return ((position % 8) + 'a'); }
        inline  int              getRow() { return ((position / 8) + 1); }
        inline  Square          *getSquare() { return square; }
        inline  void             setSquare(Square *s) { square = s; }
        inline  BitBoard         getMoves() { return moves; }
        inline  void             setMoves(BitBoard bb) { moves = bb; }
        inline  BitBoard         getAttacks() { return attacks; }
        inline  void             setAttacks(BitBoard b) { attacks = b; }
        inline  int              getMoved() { return nmoves; }
        inline  bool             isMoved() { return (nmoves); }
        inline  int              getNMoves() { return npossible; }
        inline  float            getValue() { return value; }
        inline  void             setValue(float v) { value = v; }
                void             update(Board *);
        inline  void             increaseMoves() { nmoves++; }
        inline  void             decreaseMoves() { nmoves--; }
        inline  bool             isEnabled() { return enabled; }
        inline  void             enable() { enabled = true; }
        inline  void             disable() { enabled = false; }
        virtual void             recalculateMoves(Board *) = 0;
        virtual void             recalculateAttacks(Board *) = 0;
        virtual vector<Move>     getAllMoves() = 0;
        inline  string           getName() { return pieceName(type); }
                string           toString();

    protected:
        ColorType        color;
        PieceType        type;
        BitBoard         bb;
        int              position;
        Square          *square;
        BitBoard         moves;
        int              nmoves;
        int              npossible;
        BitBoard         attacks;
        float            value;
        bool             enabled;

    private:
        string           state();             // for debug purposes
};



#endif // _PIECE_
