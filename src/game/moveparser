/*!
 * @file src/game/moveparser
 */
#ifndef _MOVEPARSER_
#define _MOVEPARSER_



// Necessary libraries
#include <iostream>
#include "definitions"
#include "game/game"
#include "game/move"
#include "game/board/board"

using namespace std;



/*!
 * Generate internal moves out of human-readable moves.
 *
 * Parse an input text and generate a internal valid move string.
 */
class MoveParser
{
    public:
        inline  void    setGame(Game *g) { lastGame = g; }
        inline  Game   *getGame() { return lastGame; }    
                Move    translate(string, MoveType, Game *);
                void    pretty(Move *);

    private:
        Game       *lastGame;
        Move        move; // temporary variable where to generate the move

        Move        translatePawn(string, Game *);
        Move        translateSimple(string, Game *);
        Move        translateCastleShort(string, Game *);
        Move        translateXY(string, Game *);
        Move        translateCapturePawn(string, Game *);
        Move        translateCapturePawnShort(string, Game *);
        Move        translateCaptureSimple(string, Game *);
        Move        translateCaptureShort(string, Game *);
        Move        translateAmbiguous(string, Game *);
        Move        translateCastleLong(string, Game *);
        Move        translateCaptureLong(string, Game *);
        Move        translatePromotionSimple(string, Game *);
        Move        translatePromotionCapture(string, Game *);
        Move        translatePromotionCaptureShort(string, Game *);
};



#endif // _MOVEPARSER_
