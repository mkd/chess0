/*!
 * @file src/game/game
 */
#ifndef _GAME_
#define _GAME_



// Necessary libraries
#include <vector>
#include <stack>
#include "definitions"
#include "game/move"
#include "game/board/board"
#include "game/board/piece"
class Piece;



/*!
 * class Game
 * Manage the game's functionality and the game behavior. Please notice that, by
 * using GameManager, one can create multiple games (Game) and manage them
 * through the manager class.
 * @see GameManager
 *
 * This class is in charge of managing all the movements and conditions related
 * to one game.
 */
class Game
{
    public:
                                     Game();
                                    ~Game();
        inline          Board       *getBoard() { return board; }
        inline          void         setBoard(Board *b) { board = b; }
                        void         displayBoard();
        inline          ColorType    getPlayer() { return player; }
        inline          void         setPlayer(ColorType ct) { player = ct; }
        inline          int          getTurn() { return turn; }
        inline          void         setTurn(int t) { turn = t; }
        inline          int          getCursor() { return cursor; }
        inline          void         setCursor(int c) { cursor = c; }
        inline          int          getMinCursor() { return min_cursor; }
        inline          void         setMinCursor(int c) { min_cursor = c; }
                        void         emptySquare(int);
                        void         setPiece(Piece *, int);
        inline          vector<Move> getHistory() { return history; }
                        string       getHistorySequence();
                        void         addToHistory(Move);
                        void         removeFromHistory(int n = 1);
                        Error        displayHistory();
                        Error        perform(Move);
                        Error        undo();
                        void         restart();
        inline          void         setEnd(EndType e) { board->setEnd(e); }
        inline          bool         isBegin()
                                     {
                                         if (cursor)
                                             return false;
                                         else
                                             return true;
                                     }
        inline          bool         isEnd() { return board->isEnd(); }
        inline          EndType      getEnd() { return board->getEnd(); }
        inline          void         editBoard() { board->edit(); }

    private:
        Board          *board;
        ColorType       player;
        int             turn;
        vector<Move>    history;
        int             cursor;      /*!< history cursor, to navigate */
        int             min_cursor;  /*!< special cursor, for board editing */
};



#endif // _GAME_
