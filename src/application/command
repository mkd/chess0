/*!
 * @file src/application/command
 */
#ifndef _COMMAND_
#define _COMMAND_



// Necessary libraries
#include <iostream>
#include <vector>
#include "definitions"



/*!
 * class Command
 * Represent an application command, containing the argument list and other
 * underlaying functionalities.
 *
 * This class provides an abstract way of creating, manipulating and executing
 * an application command.
 */
class Command
{
    public:
        inline          string          getName() { return name; }
        inline          void            setName(string n) { name = n; }
        inline          CmdType         getType() { return type; }
        inline          void            setType(CmdType ct) { type = ct; }
        inline          vector<string>  getArgs() { return args; }
        inline          void            setArgs(vector<string> a) { args = a; }
        inline          string          getArgument() { return args.back(); }
        inline          void            addArgument(string a)
                                        {
                                            args.push_back(a);
                                        }

    private:
        string          name;
        CmdType         type;
        vector<string>  args;
};



#endif // _COMMAND_
