#ifndef _BOOK_
#define _BOOK_



// Necessary libraries
#include <unordered_map>
#include <string>
#include "definitions"
#include "game/move"

using namespace std;



/*!
 * class Book
 *
 * Manage the book of openings.
 *
 * For better portability, I decided to move all the openings from an external
 * file into this class. The protected member 'book' is a map which holds an
 * opening sequence as the key (e.g., book["1. e4 e5) and a string with multiple
 * replies to the opening sequence, where each possible reply is separated from
 * the other one by the delimiter '|'. The splitting and random selection of the
 * reply is programmed in book.cpp.
 */
class Book
{
    public:
                     string       getReplyTo(string);
                                  Book();
    protected:
        // dictionary containing the database with the openings
        unordered_map<string, string> book;
};



#endif // _BOOK_
