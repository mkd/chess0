/*!
 * @file src/application/prompt
 */
#ifndef _PROMPT_
#define _PROMPT_



// Necessary libraries
#include <iostream>
#include "definitions"

using namespace std;



/*!
 * class PROMPT
 * User interface abstraction layer to communicate with the user.
 *
 * This class associates the input, output and err objects to the user
 * interface and is able to retrieve and reports events and commands to and from
 * the user, presenting it in an internal representation for the rest of the
 * classes.
 */
class Prompt
{
    public:
                Prompt(string p = "chess0 %> ", string w = "Welcome to chess0!");
        void    turn(ColorType = COLOR_TYPE_WHITE, int turn = 1);
        void    init();
        void    terminate(string str = "");

    private:
        string  welcome;
        string  promptline;
};



#endif // _PROMPT_
