/*!
 * @file src/ai/adaptive
 */
#ifndef _ADAPTIVE_
#define _ADAPTIVE_



// Necessary libraries
#include <map>
#include "definitions"
#include "ai/ai"
#include "game/move"
#include "game/moveparser"
#include "game/manager"
#include "game/board/board"

using namespace std;



/*!
 * class Adaptive
 * Engine for searching and evaluating different moves.
 *
 * This engine uses adaptive heuristics, depending on the phase of the game,
 * position of the pieces, status of the kings, etc.
 *
 * The interface used here is specified in the class AI.
 * return a move.
 *
 * @see AI
 */
class Adaptive : public AI
{
    public:
                        Adaptive(Board *, ColorType, MoveParser *, Game *);
        virtual Move    getMove();
        virtual float   evalPosition();
                void    handleInterrupt(int);

    private:
        vector<Move>    negamax(int);
        float           alphabeta(int, float, float, ColorType);
        float           quiesce(float, float, ColorType);

        // Adaptive AI extensions
        void            initSearch();
        void            sortMoves(vector<Move> &);

        /*! adaptive AI-specific parameters */
        vector<Move>    rootMoves;
        vector<Move>    bestMoves;
        bool            terminal;       /*!< marks the bottom of the tree */

        /*! temporary "global" variables used in subroutines */
        int             moved;
        int             value;
        int             pos;
        int             row;
        char            col;
        int             moves;
        bool            sd;

        // variables to adjust the depth of the quiesce() search
        unsigned short  quiesceDepth;
        unsigned short  quiesceLimit;
};



#endif // _ADAPTIVE_
