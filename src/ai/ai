/*!
 * @file src/ai/ai
 */
#ifndef _AI_
#define _AI_



// Necessary libraries
#include <ctime>
#include <unordered_map>
#include "definitions"
#include "game/move"
#include "game/moveparser"
#include "game/manager"
#include "game/board/board"

using namespace std;



/*!
 * class AI
 * Abstract class which provides an interface to any AI engine that attempts to
 * work with chess0.
 *
 * The implementation does not matter, as long as the necessary methods (such as
 * evaluation and move picking) are returned in the specified manner.
 */
class AI
{
    public:
        inline      int             getDepth() { return depth; }
        inline      void            setDepth(int d)
                                    {
                                        if (d > 0)
                                            depth = d;
                                    }
        inline      unsigned        getTPM() { return tpm; }
        inline      void            setTPM(unsigned t) { tpm = t; }
        inline      ColorType       getColor() { return color; }
        inline      void            setColor(ColorType c) { color = c; }
        inline      float           getNodes() { return nodes; }
        inline      void            setNodes(float n) { nodes = n; }
        inline      unsigned long   getAB() { return ABcall; }
        inline      Board          *getBoard() { return board; }
        inline      void            setBoard(Board *b) { board = b; }
        inline      void            setXBoard(bool x) { xboard = x; }
        inline      bool            getVerbose() { return verbose; }
        inline      void            setVerbose(bool v) { verbose = v; }
        inline      void            setPost(bool p) { post = p; }
        inline      bool            getPost() { return post; }
        inline      void            clearCache() { cache.clear(); }
        inline      float           getCacheHit() { return cacheHit; }
        inline      int             getCachePositions() { return cache.size(); }
        inline      float           getCacheSize()
                                    {
                                        return (cache.size() * (BOARD_SERIAL_SIZE + sizeof(float)));
                                    }
        inline      float           isCacheEnabled() { return useCache; }
        inline      void            enableCache() { useCache = true; }
        inline      void            disableCache()
                                    {
                                        cache.clear();
                                        useCache = false;
                                    }
        virtual     Move            getMove() = 0;
        virtual     float           evalPosition() { return 0; }
                    float           eval();
                    float           evalMaterial();
                    bool            acceptDraw();
                    void            solve(int);
                    void            displayAnalysis(Move, clock_t, int);

    protected:
        int           depth;         /*!< current search depth */
        unsigned      tpm;
        ColorType     color;
        Board        *board;
        MoveParser   *movp;
        Game         *game;
        float         nodes;
        float         cacheHit;       /*!< number of hits in the cache */
        unsigned long ABcall;         /*!< number of times alphabeta() was called */
        bool          xboard;         /*!< true if on xboard mode */
        bool          verbose;   
        bool          useCache;       /*!< true if cache is enabled */
        bool          interrupted;    /*!< for force-move */
        clock_t       start;          /*!< for measuring time */
        bool          post;

        vector<string> newPV;


        /*!
         * Cache implementation is rather rudimentary in Chess0. Instead of
         * using Least Recent Use (LRU) or similar, Chess0 simply keeps adding
         * new positions to the cache without any limit. This is due to the fact
         * that LRU introduces some delay when looking at the cache size and
         * doing the replacement itself. Since Chess0 can use a few megabytes
         * even after a very long thinking, it should not go beyond the 1GByte
         * for 1h+ games. If someone complains about not having a limit for the
         * cache, then I'll implement some cache cleaning up functionality.
         *
         * Why unordered_map? Well, using std::map has the same behavior (plus
         * it allows LRU-like deletion of oldest items, due to its ordered
         * nature), however it is 3-8x times slower in most situations. Using
         * unordered_map the performance is greatly improved, brining around 20%
         * overall performance to the whole AI engine.
         */
        unordered_map<string, float> cache;
};



#endif // _AI_
