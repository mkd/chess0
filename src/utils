/*!
 * Bitwise operations and board maths.
 *
 * Note: these defines have been borrowed from Crafty (chess.h).
 */
#define Rank(x)        ((x)>>3)
#define File(x)        ((x)&7)
#define Flip(x)        ((x)^1)
#define Abs(a)    (((a) > 0) ? (a) : -(a))
#define Max(a,b)  (((a) > (b)) ? (a) : (b))
#define Min(a,b)  (((a) < (b)) ? (a) : (b))
#define Sign(a)   ((a) < 0 ? -1 : +1)
#define FileDistance(a,b) abs(File(a) - File(b))
#define RankDistance(a,b) abs(Rank(a) - Rank(b))
#define Distance(a,b) Max(FileDistance(a,b), RankDistance(a,b))



